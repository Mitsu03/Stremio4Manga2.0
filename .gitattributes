# Line endings are not cosmetic here.
#
# The primary deployment target is Linux, and several files in this repo are
# read by something that treats CR as part of the data: a shell script with CRLF
# fails as "bad interpreter: /bin/bash^M", and systemd reads the CR as part of a
# unit's value. So text is normalised to LF in the repository, and the files
# that must stay LF in the working tree say so explicitly — a checkout on
# Windows must not turn them back.
* text=auto eol=lf

*.sh          text eol=lf
*.service     text eol=lf
Containerfile text eol=lf
Caddyfile*    text eol=lf

# The Windows side is the mirror image: cmd.exe and the script host want CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

*.png  binary
*.ico  binary
*.jpg  binary
*.webp binary
